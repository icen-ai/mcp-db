{
  "connections": {
    "dev": {
      "type": "postgres",
      "host": "127.0.0.1",
      "port": 55432,
      "database": "typlm",
      "schema": "typlm",
      "maxAffectedRows": 1,
      "roles": {
        "analyst": {
          "user": "plm_analyst",
          "password": "analyst_pw"
        },
        "ops": {
          "user": "plm_ops",
          "password": "ops_pw"
        },
        "admin": {
          "user": "dbm_admin",
          "password": "admin_pw"
        }
      }
    },
    "ga": {
      "type": "postgres",
      "host": "127.0.0.1",
      "port": 55432,
      "database": "typlm",
      "schema": "typlm",
      "requireConfirmForWrite": true,
      "roles": {
        "analyst": {
          "user": "plm_analyst",
          "password": "analyst_pw"
        },
        "admin": {
          "user": "dbm_admin",
          "password": "admin_pw"
        }
      }
    }
  },
  "grants": [
    {
      "env": "dev",
      "role": "analyst",
      "schema": "typlm",
      "tables": [
        "ty_project"
      ],
      "ops": [
        "read"
      ]
    },
    {
      "env": "dev",
      "role": "ops",
      "schema": "typlm",
      "tables": [
        "ty_*"
      ],
      "ops": [
        "read",
        "write"
      ]
    },
    {
      "env": "ga",
      "role": "analyst",
      "schema": "typlm",
      "tables": "*",
      "ops": [
        "read"
      ]
    },
    {
      "env": "ga",
      "role": "admin",
      "schema": "typlm",
      "tables": "*",
      "ops": [
        "read",
        "write",
        "ddl"
      ]
    }
  ],
  "users": [
    {
      "id": "u_analyst",
      "name": "只读用户",
      "tokens": [
        "test-token-analyst-0001"
      ],
      "roles": {
        "dev": [
          "analyst"
        ],
        "ga": [
          "analyst"
        ]
      }
    },
    {
      "id": "u_ops",
      "name": "运营用户",
      "tokens": [
        "test-token-ops-000000001"
      ],
      "roles": {
        "dev": [
          "ops"
        ]
      }
    },
    {
      "id": "u_admin",
      "name": "管理员",
      "tokens": [
        "test-token-admin-0000001"
      ],
      "roles": {
        "dev": [
          "ops",
          "analyst"
        ],
        "ga": [
          "admin"
        ]
      }
    }
  ],
  "scripts": [
    {
      "id": "fix_region",
      "title": "按编号修正区域",
      "description": "把指定项目编号的区域改为新值(参数以字面量进入 SQL)",
      "envs": [
        "dev"
      ],
      "params": [
        {
          "name": "code",
          "type": "string"
        },
        {
          "name": "region",
          "type": "string"
        }
      ],
      "previewSql": "SELECT id, project_code, region FROM typlm.ty_project WHERE project_code = :code",
      "executeSql": "UPDATE typlm.ty_project SET region = :region WHERE project_code = :code"
    },
    {
      "id": "count_by_region",
      "title": "按区域统计项目数",
      "envs": [
        "dev"
      ],
      "params": [
        {
          "name": "region",
          "type": "string",
          "required": false
        }
      ],
      "previewSql": "SELECT region, COUNT(*) AS c FROM typlm.ty_project WHERE (:region IS NULL OR region = :region) GROUP BY region"
    }
  ],
  "audit": {
    "path": "./data/test-audit.jsonl"
  }
}
