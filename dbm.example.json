{
  "//": "示例配置:复制为 dbm.config.json(已 gitignore)。密码支持 ${ENV_NAME} 插值——提交占位符,真值走环境变量。首次使用先跑 mcp-db sync 把清单物化为数据库 GRANT。",
  "connections": {
    "dev": {
      "type": "postgres",
      "host": "192.168.112.205",
      "port": 5432,
      "database": "typlm",
      "schema": "typlm",
      "roles": {
        "analyst": { "user": "plm_analyst", "password": "${DEV_ANALYST_PASSWORD}", "max": 4 },
        "ops": { "user": "plm_ops", "password": "${DEV_OPS_PASSWORD}", "max": 4 },
        "admin": { "user": "plm_admin", "password": "${DEV_ADMIN_PASSWORD}", "max": 2 }
      }
    },
    "ga": {
      "type": "postgres",
      "host": "192.168.112.25",
      "port": 5432,
      "database": "typlm",
      "schema": "typlm",
      "requireConfirmForWrite": true,
      "confirmPhrase": "生产执行",
      "roles": {
        "analyst": { "user": "plm_analyst", "password": "${GA_ANALYST_PASSWORD}", "max": 2 },
        "admin": { "user": "plm_admin", "password": "${GA_ADMIN_PASSWORD}", "max": 2 }
      }
    },
    "hub": {
      "type": "mcp-proxy",
      "command": "npx",
      "args": ["-y", "@bytebase/dbhub", "--dsn", "${PROXY_DSN}"],
      "database": "dbhub-upstream",
      "schema": "public",
      "dialect": "postgres",
      "parseMode": "json",
      "tools": { "query": { "name": "execute_sql", "args": { "sql": "$sql" } } },
      "roles": { "default": {} }
    }
  },
  "grants": [
    { "env": "dev", "role": "analyst", "schema": "typlm", "tables": "*", "ops": ["read"] },
    { "env": "dev", "role": "ops", "schema": "typlm", "tables": ["ty_project", "ty_part_master"], "ops": ["read", "write"] },
    { "env": "dev", "role": "admin", "schema": "typlm", "tables": "*", "ops": ["read", "write", "ddl"] },
    { "env": "ga", "role": "analyst", "schema": "typlm", "tables": "*", "ops": ["read"] },
    { "env": "ga", "role": "admin", "schema": "typlm", "tables": "*", "ops": ["read", "write", "ddl"] }
  ],
  "users": [
    {
      "id": "u_zhang",
      "name": "数据运营",
      "tokens": ["${TOKEN_ZHANG}"],
      "roles": { "dev": ["analyst", "ops"], "ga": ["analyst"], "hub": ["default"] }
    },
    {
      "id": "u_admin",
      "name": "管理员",
      "tokens": ["${TOKEN_ADMIN}"],
      "roles": { "dev": ["ops", "analyst", "admin"], "ga": ["admin"] }
    }
  ],
  "scripts": [
    {
      "id": "fix_project_region",
      "title": "按编号修正项目区域",
      "description": "预审过的受控操作:参数以字面量进入 SQL,Agent 只传参数",
      "envs": ["dev"],
      "params": [
        { "name": "code", "type": "string", "description": "项目编号,如 P7-260001" },
        { "name": "region", "type": "string", "description": "新区域,如 华东" }
      ],
      "previewSql": "SELECT id, project_code, region FROM typlm.ty_project WHERE project_code = :code",
      "executeSql": "UPDATE typlm.ty_project SET region = :region WHERE project_code = :code"
    }
  ],
  "audit": { "path": "./data/audit.jsonl" }
}

